# Firebase ortam değişkenleri — bu dosyayı .env olarak kopyalayın.
# Expo: EXPO_PUBLIC_ öneki zorunludur.
#
# Firebase Console > Project Settings > Your apps > Web app config
#
# Değişiklikten sonra: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Firebase / Google Cloud OAuth)
# webClientId: genelde Web application OAuth client id
# iosClientId: iOS OAuth client id (iOS build için)
# Native Google Sign-In Expo Go'da çalışmayabilir → development build gerekir.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Araç Pazarı: development'ta otomatik açık; internal/production build için explicit rollout.
EXPO_PUBLIC_VEHICLE_MARKETPLACE_ENABLED=true

# Internal Testing backend tanılama paneli (UID/token/API key göstermez).
EXPO_PUBLIC_BACKEND_DIAGNOSTICS_ENABLED=true

# Trusted backend tamamlanana kadar production'da kapalıdır.
# Internal Testing: true. Production default false until callables are deployed + verified.
EXPO_PUBLIC_LEADERBOARD_ENABLED=false
EXPO_PUBLIC_MARKET_ALARMS_ENABLED=false

# Ads / AdMob
# Internal Testing: USE_TEST_IDS=true (Google TestIds.REWARDED)
# Store release: USE_TEST_IDS=false ve gerçek rewarded unit ID'leri
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADS_USE_TEST_IDS=true
# EXPO_PUBLIC_ADS_MODE=test

# Yalnız geçici development teşhisi için açın; varsayılan kapalıdır.
# EXPO_PUBLIC_DEBUG_CLOUD_SAVE_CONFLICT=1
