# Firebase ortam değişkenleri — bu dosyayı .env olarak kopyalayın.
# Expo: EXPO_PUBLIC_ öneki zorunludur.
#
# Firebase Console > Project Settings > Your apps > Web app config
#
# Değişiklikten sonra: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCCWDdBsbK5B0ObQa5fTlFG6pQBIPtFZSQ
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=logisticore-53ab4.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=logisticore-53ab4
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=logisticore-53ab4.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=363783837598
EXPO_PUBLIC_FIREBASE_APP_ID=1:363783837598:ios:d813853d3ada916ca6288f

# Google Sign-In (Firebase / Google Cloud OAuth)
# webClientId: genelde Web application OAuth client id
# iosClientId: iOS OAuth client id (iOS build için)
# Native Google Sign-In Expo Go'da çalışmayabilir → development build gerekir.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
