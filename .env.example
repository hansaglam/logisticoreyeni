# Firebase ortam değişkenleri — bu dosyayı .env olarak kopyalayın.
# Expo: EXPO_PUBLIC_ öneki zorunludur.
#
# Firebase Console > Project Settings > Your apps > Web app config
#
# Değişiklikten sonra: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCCWDdBsbK5B0ObQa5fTlFG6pQBIPtFZSQ
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=logisticore-53ab4.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=logisticore-53ab4
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=logisticore-53ab4.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=363783837598
EXPO_PUBLIC_FIREBASE_APP_ID=1:363783837598:ios:d813853d3ada916ca6288f

# Google Sign-In (Firebase / Google Cloud OAuth)
# webClientId: genelde Web application OAuth client id
# iosClientId: iOS OAuth client id (iOS build için)
# Native Google Sign-In Expo Go'da çalışmayabilir → development build gerekir.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Araç Pazarı: development'ta otomatik açık; internal/production build için explicit rollout.
EXPO_PUBLIC_VEHICLE_MARKETPLACE_ENABLED=true

EXPO_PUBLIC_VEHICLE_MARKETPLACE_ENABLED=true
EXPO_PUBLIC_LEADERBOARD_ENABLED=true
EXPO_PUBLIC_MARKET_ALARMS_ENABLED=false

# V1.1 foundation — production rollout tamamlanana kadar false.
EXPO_PUBLIC_ENABLE_SEASONS=false
EXPO_PUBLIC_ENABLE_CHALLENGES=false
EXPO_PUBLIC_ENABLE_DRIVER_PROGRESSION=false
EXPO_PUBLIC_ENABLE_COMPANY_STATS=false
EXPO_PUBLIC_ENABLE_ACHIEVEMENTS=false
EXPO_PUBLIC_ENABLE_SEASON_HISTORY=false
EXPO_PUBLIC_ENABLE_INBOX=false
EXPO_PUBLIC_ENABLE_MARKET_ALERTS=false
EXPO_PUBLIC_ENABLE_NOTIFICATION_CENTER=false
EXPO_PUBLIC_ENABLE_V11_ANALYTICS=false

# Genel ilk giriş rehberi (tüm ekran tutorial overlay). false = acil kapatma.
EXPO_PUBLIC_APP_TUTORIALS_ENABLED=true

# Build profiles — see .env.internal and .env.production
# LOGISTICORE_BUILD_PROFILE=internal|production

# Internal Testing backend tanılama paneli (UID/token/API key göstermez).
# Store production: must be false (.env.production)
EXPO_PUBLIC_BACKEND_DIAGNOSTICS_ENABLED=true

# TEST-ONLY: live sync users/{uid}.money from Firestore Console into player.money.
# Internal Testing: true. Store production: must be unset/false.
# EXPO_PUBLIC_ENABLE_TEST_MONEY_SYNC=true

# Trusted backend tamamlanana kadar production'da kapalıdır.
# Internal Testing: true. Production default false until callables are deployed + verified.
EXPO_PUBLIC_LEADERBOARD_ENABLED=false
EXPO_PUBLIC_MARKET_ALARMS_ENABLED=false

# Ads / AdMob
# Internal Testing: USE_TEST_IDS=true (Google TestIds.REWARDED)
# Store release: USE_TEST_IDS=false ve gerçek rewarded unit ID'leri
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADS_USE_TEST_IDS=true
# EXPO_PUBLIC_ADS_MODE=test

# Yalnız geçici development teşhisi için açın; varsayılan kapalıdır.
# EXPO_PUBLIC_DEBUG_CLOUD_SAVE_CONFLICT=1
