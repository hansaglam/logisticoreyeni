{
  "name": "logisticore-backend",
  "version": "1.0.0",
  "private": true,
  "main": "lib/backend/src/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "sync:canonical": "node --import tsx scripts/syncCanonicalInputs.ts",
    "build": "npm run sync:canonical && tsc",
    "typecheck": "npm run sync:canonical && tsc --noEmit",
    "marketplace:migrate": "npm run sync:canonical && node --import tsx scripts/migrateMarketplaceStates.ts",
    "marketplace:smoke:production": "npm run sync:canonical && node --import tsx scripts/productionMarketplaceSmoke.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.3",
    "@types/node": "^22.10.0",
    "firebase": "10.12.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
