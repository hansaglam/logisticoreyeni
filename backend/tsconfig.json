{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "scripts/**/*.ts",
    "../src/domain/truckResaleValuation.ts",
    "../src/domain/vehicleMarketplaceCloudMerge.ts",
    "../src/domain/canonicalCashOperation.ts",
    "../src/domain/canonicalRoadDelivery.ts",
    "../src/domain/canonicalRoadEconomics.ts",
    "../src/domain/canonicalRoadContract.ts",
    "../src/data/routes.ts",
    "../src/data/products.ts",
    "../src/simulation/contractEconomics.ts",
    "../src/domain/canonicalMultimodalRailEconomics.ts",
    "../src/domain/multimodalRailTariff.ts",
    "../src/domain/multimodalRoadAccess.ts",
    "../src/mapV2/generated/multimodal/turkey-road-transfer-access.json"
  ]
}
