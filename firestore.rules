rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Private player profile, cloud save and sync metadata.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /saves/{saveId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.ownerUid == userId;
      }

      match /meta/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Backend alarm evaluation is V2. Direct client writes remain disabled so
      // production cannot expose an unevaluated or spoofable alarm system.
      match /marketAlerts/{alertId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Marketplace cash, ownership, history and ledger are Admin SDK managed.
      match /marketplaceState/{documentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /marketplaceHistory/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /marketplaceLedger/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Active offers are publicly browseable. Historical records are visible
    // only to their seller/buyer. Every mutation is a trusted callable action.
    match /vehicleMarketplaceListings/{listingId} {
      allow read: if resource.data.status == 'active'
        || (signedIn()
          && (resource.data.sellerUid == request.auth.uid
            || resource.data.buyerUid == request.auth.uid));
      allow write: if false;
    }

    match /vehicleMarketplaceTransactions/{transactionId} {
      allow read: if signedIn()
        && (resource.data.sellerUid == request.auth.uid
          || resource.data.buyerUid == request.auth.uid);
      allow write: if false;
    }

    match /vehicleMarketplaceIdempotency/{documentId} {
      allow read, write: if false;
    }

    match /vehicleMarketplaceActionReceipts/{documentId} {
      allow read, write: if false;
    }

    match /vehicleMarketplaceRateLimits/{documentId} {
      allow read, write: if false;
    }

    // Authenticated players may read the authoritative world market.
    // Admin SDK bypasses rules; normal clients can never write these paths.
    match /globalEconomy/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /globalEconomySnapshots/{snapshotId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /globalMarketHistory/{historyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Read-only for clients. Scores are written only by Admin SDK callables.
    match /leaderboards/{seasonId}/entries/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /leaderboardIdempotency/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
