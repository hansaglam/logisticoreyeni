{
  "name": "logisticore",
  "version": "0.1.0",
  "private": true,
  "description": "LogistiCore — mobil lojistik şirketi yönetim simülasyonu",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npx tsx scripts/check-require-cycles.ts",
    "backend:build": "npm --prefix backend run build",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:verify": "npm run backend:typecheck && npm run backend:build && npx tsx scripts/backend-function-consistency-test.ts && npx tsx scripts/check-require-cycles.ts && npm run firebase:emulators:test && npx tsx scripts/cloud-save-conflict-test.ts && npx tsx scripts/cloud-save-production-audit-test.ts",
    "marketplace:migrate:dry": "npm --prefix backend run marketplace:migrate -- --dry-run",
    "marketplace:migrate": "npm --prefix backend run marketplace:migrate",
    "marketplace:smoke:production": "npm --prefix backend run marketplace:smoke:production -- --confirm-production",
    "test:firebase": "npm --prefix backend test",
    "firebase:emulators:test": "firebase emulators:exec --only firestore \"npm run backend:build && npm run test:firebase\"",
    "android": "expo run:android",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "firebase": "10.12.5",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "@types/react": "~19.1.0",
    "firebase-tools": "^14.27.0",
    "typescript": "^5.7.3"
  }
}
